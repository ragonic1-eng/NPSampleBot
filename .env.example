# Copy this file to .env and fill in the values.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_here

# --- Google Sheets ---
# Path to the service account JSON key file you download from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The seasoning master sheet (read-only). Already given to you.
SEASONING_SHEET_ID=1ISo8GyI_btbnHcPwr0q6owotoT1mO4ZykYPwfNmwCNg
SEASONING_WORKSHEET_NAME=Sheet1

# The workbook that holds Customers, Sales Log, Users tabs. Create a new
# Google Sheet, paste its ID here (the long string in the URL).
OPS_SHEET_ID=paste_new_sheet_id_here

# --- AI brains (optional but recommended) ---
# Main brain
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-haiku-4-5

# Backup brain (local Ollama). Leave as-is if you're running ollama locally.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# --- Behavior ---
DRAFT_TIMEOUT_MINUTES=30

# --- Quotation builder (Vercel) ---
# Public URL of the Vercel-hosted quotation web app — see quote_web/README.md
# for setup. /quote will send a button that opens this URL with the rep's
# sales name pre-filled via ?sales=. Leave blank until you've deployed.
QUOTE_WEB_URL=

# --- AWB sync (DHL Express + FedEx) ---
# Login credentials for the twice-daily scrape (07:00 + 20:00 SGT) that
# fills the AWB column on the Full Sample Listing tabs. Set these on
# Railway's Variables tab, NEVER commit values here. Leaving either
# empty disables that carrier; both empty means no AWBs get filled.
DHL_USER=
DHL_PASS=
FEDEX_USER=
FEDEX_PASS=
# Set AWB_TEST_MODE=1 in local dev to return hardcoded test shipments
# (skips the real DHL/FedEx login). Leave blank in production.
AWB_TEST_MODE=
